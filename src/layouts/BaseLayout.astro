---
import { getSite } from "../lib/content";
import Contact from "../components/Contact.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  contact?: boolean;
  noindex?: boolean;
}
const site = await getSite();
const { title, description = site.description, contact = true, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const canonical = new URL(Astro.url.pathname, site.url);
const path = Astro.url.pathname;
const analyticsEnabled = import.meta.env.PROD && site.analytics.enabled;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.fullName,
  url: site.url,
  jobTitle: site.role,
  worksFor: { "@type": "Organization", name: site.employer, url: site.employerUrl },
  email: `mailto:${site.email}`,
  sameAs: site.social.map((link) => link.href),
};
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FAF9F6" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="google-site-verification" content={site.searchConsoleVerification} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.language.replace("-", "_")} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, "\u003c")} />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <header class="site-header container">
      <a class="brand" href="/" aria-label={`${site.name}, home`}>
        <span class="brand-mark" aria-hidden="true">
          {site.initials.toLowerCase()}
          <span class="brand-dot">.</span>
        </span>
        <span>{site.name}</span>
      </a>
      <nav aria-label="Main navigation">
        <ul class="nav-links">
          {site.navigation.map((link) => (
            <li>
              <a href={link.href} aria-current={path.startsWith(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a class="resume-link" href={site.resume} aria-current={path === site.resume ? "page" : undefined}>
              Resume
            </a>
          </li>
        </ul>
      </nav>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      {contact && <Contact />}
      <div class="footer-bottom container">
        <span>
          © {new Date().getFullYear()} {site.name}
        </span>
        <span>{site.footer}</span>
        <a href="#top">
          Back to top <span aria-hidden="true">↑</span>
        </a>
      </div>
    </footer>
    {analyticsEnabled && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.analytics.googleId}`}></script>
        <script is:inline define:vars={{ analyticsId: site.analytics.googleId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            window.dataLayer.push(arguments);
          }
          gtag("js", new Date());
          gtag("config", analyticsId);
        </script>
      </>
    )}
  </body>
</html>
