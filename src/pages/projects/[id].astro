---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Arrow from "../../components/Arrow.astro";
import { getProjects } from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}
interface Props {
  project: CollectionEntry<"projects">;
  next: CollectionEntry<"projects"> | undefined;
}
const { project, next } = Astro.props;
const { data } = project;
---

<BaseLayout title={data.title} description={data.summary}>
  <article class="container interior-page project-detail">
    <a class="text-link breadcrumb" href="/projects/">
      <span aria-hidden="true">←</span> All projects
    </a>
    <header class="page-intro">
      <p class="eyebrow">
        {data.category} <span aria-hidden="true">/</span> {data.year}
      </p>
      <h1>{data.title}</h1>
      <p class="lead">{data.summary}</p>
    </header>
    <dl class="project-facts">
      <div>
        <dt>My role</dt>
        <dd>{data.role}</dd>
      </div>
      <div>
        <dt>Context</dt>
        <dd>{data.context}</dd>
      </div>
      <div>
        <dt>When</dt>
        <dd>{data.period}</dd>
      </div>
    </dl>
    <div class="project-body prose">
      {data.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {section.bullets && (
            <ul>
              {section.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          )}
        </section>
      ))}
      <aside class="outcome" aria-label="Project outcome">
        <p class="eyebrow">Outcome</p>
        <p>{data.outcome}</p>
      </aside>
      <section>
        <h2>Tools & techniques</h2>
        <ul class="stack-list">
          {data.stack.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
      {data.links.length > 0 && (
        <section>
          <h2>Explore further</h2>
          <ul class="resource-links">
            {data.links.map((link) => (
              <li>
                <a class="text-link" href={link.href}>
                  {link.label}
                  <Arrow direction="diagonal" size={18} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
    {next && next.id !== project.id && (
      <nav class="next-project" aria-label="More projects">
        <span class="eyebrow">Next project</span>
        <a href={`/projects/${next.id}/`}>
          {next.data.shortTitle}
          <Arrow size={24} />
        </a>
      </nav>
    )}
  </article>
</BaseLayout>
