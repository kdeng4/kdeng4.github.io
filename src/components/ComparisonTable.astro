---
import type { CollectionEntry } from "astro:content";

interface Props {
  comparison: NonNullable<CollectionEntry<"projects">["data"]["sections"][number]["comparison"]>;
}
const { comparison } = Astro.props;
---

<table class="comparison" role="table">
  <caption>{comparison.caption}</caption>
  <thead role="rowgroup">
    <tr role="row">
      <th scope="col" role="columnheader">
        Approach
      </th>
      <th scope="col" role="columnheader">
        Strength
      </th>
      <th scope="col" role="columnheader">
        Tradeoff
      </th>
    </tr>
  </thead>
  <tbody role="rowgroup">
    {comparison.rows.map((row) => (
      <tr role="row">
        <th scope="row" role="rowheader">
          <span class="mobile-label" aria-hidden="true">
            Approach
          </span>
          {row.option}
        </th>
        <td role="cell">
          <span class="mobile-label" aria-hidden="true">
            Strength
          </span>
          {row.benefit}
        </td>
        <td role="cell">
          <span class="mobile-label" aria-hidden="true">
            Tradeoff
          </span>
          {row.tradeoff}
        </td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .comparison {
    width: 100%;
    margin-top: 24px;
    border-collapse: collapse;
    table-layout: fixed;
    font: inherit;
    text-align: left;
    color: var(--text);
  }

  caption {
    margin-bottom: 16px;
    text-align: left;
    color: var(--muted);
  }

  th,
  td {
    padding: 16px 12px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    overflow-wrap: anywhere;
  }

  th {
    font-weight: 600;
  }

  th:first-child {
    width: 24%;
    padding-left: 0;
  }

  th:last-child,
  td:last-child {
    padding-right: 0;
  }

  thead th {
    color: var(--muted);
  }

  .mobile-label {
    display: none;
  }

  @media (max-width: 40rem) {
    .comparison,
    caption,
    tbody,
    tr,
    th,
    td {
      display: block;
    }

    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    tbody tr {
      padding-block: 20px;
      border-top: 1px solid var(--line);
    }

    tbody tr:last-child {
      border-bottom: 1px solid var(--line);
    }

    th,
    td,
    th:first-child {
      width: auto;
      padding: 0;
      border: 0;
    }

    td {
      margin-top: 16px;
    }

    .mobile-label {
      display: block;
      margin-bottom: 4px;
      color: var(--muted);
      font-weight: 600;
    }
  }
</style>
