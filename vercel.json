    {
      "source": "/projects/master-to-phd-pathway-study/",
      "destination": "/projects/masters-to-phd/",
      "permanent": true
    },
    {
      "source": "/projects/Master%20to%20PhD%20Pathway%20Study/",
      "destination": "/projects/masters-to-phd/",
      "permanent": true
    },
    {
      "source": "/projects/Master-to-PhD-Pathway-Study/",
      "destination": "/projects/masters-to-phd/",
      "permanent": true
    }
  ]
}
