{
  "name": "Patrick's portfolio",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-24-bookworm",
  "postCreateCommand": "npm ci",
  "forwardPorts": [4321],
  "customizations": {
    "vscode": {
      "extensions": ["astro-build.astro-vscode", "esbenp.prettier-vscode", "redhat.vscode-yaml"],
      "settings": { "editor.formatOnSave": true, "editor.defaultFormatter": "esbenp.prettier-vscode" }
    }
  },
  "remoteUser": "node"
}
